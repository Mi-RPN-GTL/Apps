    "d8.dex": "dex/r8.jar",
    "r8.dex": "dex/r8.jar",
    "ecj.dex": "dex/ecj.jar"
   },
   "files": [
    {
     "urls": [
      "https://maven.google.com/com/android/tools/r8/8.7.18/r8-8.7.18.jar"
     ],
     "dest": "r8/r8.jar"
    },
    {
     "urls": [
      "https://repo1.maven.org/maven2/org/eclipse/jdt/ecj/3.38.0/ecj-3.38.0.jar"
     ],
     "dest": "ecj/ecj.jar"
    },
    {
     "urls": [
      "https://dl.google.com/android/repository/platform-35_r02.zip",
      "https://dl.google.com/android/repository/platform-35_r01.zip",
      "https://dl.google.com/android/repository/platform-34-ext7_r02.zip"
     ],
     "dest": "android.jar",
     "zip_member": "android-35/android.jar"
    }
   ],
   "inproc": [
    {
     "name": "r8",
     "jar": "r8/r8.jar",
     "sources": [
      "D8Entry.java",
      "R8Entry.java"
     ],
     "out": "dex/r8.jar",
     "classes": [
      "D8Entry",
      "R8Entry"
     ],
     "check": "d8"
    },
    {
     "name": "ecj",
     "jar": "ecj/ecj.jar",
     "sources": [
      "EcjEntry.java"
     ],
     "out": "dex/ecj.jar",
     "classes": [
      "EcjEntry"
     ],
     "check": "ecj",
     "resources": [
      "org/eclipse/jdt/internal/compiler/batch/messages.properties"
     ]
    }
   ]
  },
